# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ── Virtual environments ──
venv/
.venv/
env/
ENV/

# ── PyInstaller ──
# (.gitignore has no inline comments — keep notes on their own line)
*.manifest
# *.spec is regenerated by build.py on every run
*.spec
TaskManager.spec

# ── Test / tooling caches ──
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── App runtime data (must survive updates, never in VCS) ──
/logs/
/.update_backup/
/data/db/*.json
!/data/db/.gitkeep
update.log
update_restart.cmd
*.updated

# ── OS / editor ──
.DS_Store
Thumbs.db
.idea/
*.swp
/.claude
