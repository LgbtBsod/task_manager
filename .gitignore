# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ── Virtual environments ──
venv/
.venv/
env/
ENV/

# ── PyInstaller ──
*.manifest
# NOTE: TaskManager.spec is intentionally tracked

# ── Test / tooling caches ──
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── App runtime data (must survive updates, never in VCS) ──
/logs/
/.update_backup/
/data/db/*.json
!/data/db/.gitkeep
update.log
update_restart.cmd
*.updated

# ── OS / editor ──
.DS_Store
Thumbs.db
.idea/
*.swp
